# =============================================================================
# AURA Environment Variables Example
# Copy to .env.local for local development or configure in Vercel Project Settings.
# NEVER commit .env.local or real secret values to Git.
# =============================================================================

# --- Required in Production (Supabase PostgreSQL) ---
# Find in Supabase Dashboard -> Project Settings -> API
# Server-side only (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Required in Production (Private Vercel Blob Storage) ---
# Create a PRIVATE Vercel Blob store in Vercel Dashboard -> Storage -> Blob
# Server-side only (read/written exclusively through authenticated API routes)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_private_store_token

# --- Authentication & Session Security (Required in Production) ---
# Strong random 32+ character string (e.g., output of: openssl rand -hex 32)
AUTH_SESSION_SECRET=replace_with_32_byte_random_hex_secret

# --- Google Gemini API (Multimodal Extraction, Form Guide OCR & Reasoning) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional preferred model override (defaults to fallback list starting with gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash

# --- Gnani AI (Prisma v2.5 STT & Timbre v2.5 TTS Voice Assistant) ---
# Get your API key from the Gnani API Dashboard (https://api.vachana.ai)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai

# --- Optional: Evon Open-Weight Reasoning Endpoint ---
USE_EVON=false
EVON_BASE_URL=
EVON_API_KEY=
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
